{
  "name": "wedding-venue-quiz",
  "private": true,
  "version": "0.0.0-development",
  "description": "Orlando wedding venue matching quiz: static frontend + Vercel serverless API + Kit.",
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run typecheck && npm run test:coverage",
    "release": "semantic-release"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vercel/node": "^3.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "semantic-release": "^24.2.9",
    "typescript": "^5.6.2",
    "vercel": "^37.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
