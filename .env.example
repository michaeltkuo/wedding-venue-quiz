# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kit account settings -> Developer -> API (create a V4 API key)
KIT_API_KEY=

# Google Sheet: File -> Share -> Publish to web -> select the venue tab -> CSV
VENUE_SHEET_CSV_URL=

# Shared secret required in the x-import-secret header when calling POST /api/import-venues
IMPORT_ADMIN_SECRET=

# Vercel deployment protection password (optional, existing)
VERCEL_APP_PASSWORD=
