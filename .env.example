# Copy to .env and fill in real values. Never commit .env (see .gitignore).
#
# Both variables below are OPTIONAL in the current test phase. With neither set, the quiz runs
# entirely on the committed data/venues.csv and does not talk to Kit.

# Kit account settings -> Developer -> API (create a V4 API key)
# Leave blank to disable the Kit sync. When blank, the submitted email is used for nothing and is
# not stored anywhere.
KIT_API_KEY=

# Venue data source override.
# Unset (default): venues are read from the committed data/venues.csv; edit that file and redeploy.
# Set: Google Sheet -> File -> Share -> Publish to web -> select the venue tab -> CSV. The published
# CSV is fetched and cached in memory for a few minutes, so sheet edits go live without a redeploy.
VENUE_SHEET_CSV_URL=

# Vercel deployment protection password (optional, existing)
VERCEL_APP_PASSWORD=
